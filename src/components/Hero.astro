---
const personalImageAlt = "Edwin Mendoza"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
import GitHubLogo from "./icons/GithubLogo.astro"
import Whatsapp from "./icons/Whatsapp.astro"
import Telegram from "./icons/Telegram.astro"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/edwin.avif"
      alt={personalImageAlt}
    />
    <a
      href="https://linkedin.com/in/edwindev6"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hola, soy Edwin Mendoza
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-green-200 [&>strong]:text-green-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    +2 años de experiencia. <strong
      >Frontend Developer </strong
    > de Republica Dominicana, La Vega. Especializado en el desarrollo de aplicaciones web
    únicas.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:edwinmendoza0620@gmail.com">
      <MailIcon class="size-4" />
      Correo
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/edwindev6">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/EdwinDev6">
    <GitHubLogo class="size-4" />
    Github
    </SocialPill>
     <SocialPill href="https://wa.link/woaj3m">
     <Whatsapp class="size-4" />
      Whatsapp
     </SocialPill>
     <SocialPill href="https://telegram.me/Edwindev6">
     <Telegram class="size-4" />
      Telegram
     </SocialPill>
  </nav>
</div>
