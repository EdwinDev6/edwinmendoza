---
import { TAGS } from '../components/Projects.astro';
const tagsArray = Object.values(TAGS);
---

<section class="max-w-5xl mx-auto px-4 text-center">
  <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-4">💻 Mis Habilidades</h2>
  <p class="text-gray-600 dark:text-gray-300 mb-10">Tecnologías y herramientas que utilizo.</p>

  <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2">
    {tagsArray.map(tag => (
      <div class={`rounded-lg shadow p-1 flex flex-col items-center hover:scale-105 transition ${tag.class}`}>
        <tag.icon class="w-6 h-6 mb-1" />
        <span class="text-xs font-medium">{tag.name}</span>
      </div>
    ))}
  </div>
</section>
